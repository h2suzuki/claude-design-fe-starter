}
function registryCard(kind){
  const r = regOf(kind);
  if (!r) return '<div class="card"><h3>REGISTRY (共通語彙)</h3><div class="mono">(registry 未定義の kind: ' + H(kind) + ')</div></div>';
  return '<div class="card"><h3>REGISTRY (共通語彙)</h3>' +
    '<div><span class="st ' + H(r.status) + '">' + H(r.status) + '</span> <span class="mono">' + H(r.name) + '</span></div>' +
    '<div class="mono" style="margin-top:6px">' + regDetail(r) + '</div></div>';
