#!/usr/bin/env node
// screens/<slug>.ui-ast.json + registry.json + 任意のスクショから自己完結 HTML viewer を 1 file 生成する
"use strict";

const { existsSync, readFileSync, readdirSync, writeFileSync } = require("node:fs");
const { basename, dirname, extname, join, resolve } = require("node:path");

const PROG = "ast-viewer";
const AST_VERSION = "0.2.0";
const IMAGE_MIME = {
  ".png": "image/png",
  ".jpg": "image/jpeg",
  ".jpeg": "image/jpeg",
  ".webp": "image/webp",
};

const USAGE = [
  "Usage:",
  "    " + PROG + " {-h|--help}",
  "    " + PROG + " <screen.ui-ast.json> [--registry <file>] [--screenshots <dir>] [-o <out.html>]",
  "",
  "Defaults:",
  "    --registry     <screen dir>/../registry.json  (存在する場合のみ)",
  "    --screenshots  <screen dir>/../../ui-mock/screenshots  (存在する場合のみ)",
  "    -o             ./<slug>.viewer.html",
  "",
  "スクショが無い場合は region 枠面と crop を省略し、残りの面だけを描画する。",
].join("\n");

function die(message, code = 64) {
  process.stderr.write(PROG + ": " + message + "\n");
  process.exit(code);
}

function warn(message) {
  process.stderr.write(PROG + ": warning: " + message + "\n");
}

function loadJson(path) {
  let text;
  try {
    text = readFileSync(path, "utf8");
  } catch (error) {
    die("cannot read " + path + ": " + error.message, 66);
  }
  try {
    return JSON.parse(text);
  } catch (error) {
    die("invalid JSON in " + path + ": " + error.message, 65);
  }
}

function parseArgs(argv) {
  const opts = { screen: "", registry: "", screenshots: "", out: "" };
  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i];
    const value = () => {
      const v = argv[++i];
      if (v === undefined) die("missing value for " + arg);
      return v;
    };
    if (arg === "-h" || arg === "--help") {
      process.stdout.write(USAGE + "\n");
      process.exit(0);
    } else if (arg === "--registry") opts.registry = value();
    else if (arg === "--screenshots") opts.screenshots = value();
    else if (arg === "-o" || arg === "--out") opts.out = value();
    else if (arg.startsWith("-")) die("unknown option: " + arg);
    else if (!opts.screen) opts.screen = arg;
    else die("unexpected argument: " + arg);
  }
  if (!opts.screen) die("screen ui-ast.json is required\n" + USAGE);
  return opts;
}

// crop の背景倍率に実寸が要るので画像 header から直接読む
function imageSize(buf) {
  if (buf.length > 24 && buf.readUInt32BE(0) === 0x89504e47) {
    return { w: buf.readUInt32BE(16), h: buf.readUInt32BE(20) };
  }
  if (buf.length > 4 && buf[0] === 0xff && buf[1] === 0xd8) return jpegSize(buf);
  if (buf.length > 30 && buf.toString("ascii", 0, 4) === "RIFF" && buf.toString("ascii", 8, 12) === "WEBP") {
    return webpSize(buf);
  }
  return null;
}

function jpegSize(buf) {
  let i = 2;
  while (i + 9 < buf.length) {
    if (buf[i] !== 0xff) {
      i++;
      continue;
    }
    const marker = buf[i + 1];
    if (marker === 0xd8 || marker === 0x01 || (marker >= 0xd0 && marker <= 0xd7)) {
      i += 2;
      continue;
    }
    const isFrame = marker >= 0xc0 && marker <= 0xcf && marker !== 0xc4 && marker !== 0xc8 && marker !== 0xcc;
    if (isFrame) return { h: buf.readUInt16BE(i + 5), w: buf.readUInt16BE(i + 7) };
    i += 2 + buf.readUInt16BE(i + 2);
  }
  return null;
}

function webpSize(buf) {
  const format = buf.toString("ascii", 12, 16);
  if (format === "VP8X") return { w: buf.readUIntLE(24, 3) + 1, h: buf.readUIntLE(27, 3) + 1 };
  if (format === "VP8 ") return { w: buf.readUInt16LE(26) & 0x3fff, h: buf.readUInt16LE(28) & 0x3fff };
  if (format === "VP8L") {
    const bits = buf.readUInt32LE(21);
    return { w: (bits & 0x3fff) + 1, h: ((bits >> 14) & 0x3fff) + 1 };
  }
  return null;
}

function indexNodes(screen) {
  const list = [];
  const walk = (node) => {
    list.push(node);
    for (const child of node.children || []) walk(child);
  };
  for (const node of screen.children || []) walk(node);
  for (const node of screen.overlays || []) walk(node);
  return list;
}

// source.region (0..1 正規化) を参照先スクショごとに束ねる = 原型の regions.states 相当
function buildShots(nodes, dir) {
  if (!dir) return [];
  let entries;
  try {
    entries = readdirSync(dir).sort();
  } catch (error) {
    die("cannot read screenshots dir " + dir + ": " + error.message, 66);
  }
  const images = entries.filter((name) => IMAGE_MIME[extname(name).toLowerCase()]);
  if (!images.length) {
    warn("no image file in " + dir + " (region 枠面を省略)");
    return [];
  }
  const byImage = new Map();
  const missing = new Set();
  for (const node of nodes) {
    const region = node.source && node.source.region;
    if (!Array.isArray(region) || region.length !== 4) continue;
    const named = node.source.file ? basename(node.source.file) : "";
    const isImageRef = Boolean(IMAGE_MIME[extname(named).toLowerCase()]);
    const ref = isImageRef ? named : images.length === 1 ? images[0] : "";
    if (!ref) continue;
    if (!images.includes(ref)) {
      missing.add(ref);
      continue;
    }
    if (!byImage.has(ref)) byImage.set(ref, {});
    byImage.get(ref)[node.id] = region;
  }
  for (const name of [...missing].sort()) warn("source.file not found in screenshots dir: " + name);

  const shots = [];
  for (const name of [...byImage.keys()].sort()) {
    const buf = readFileSync(join(dir, name));
    const size = imageSize(buf);
    if (!size || !size.w || !size.h) {
      warn("unreadable image header, skipped: " + name);
      continue;
    }
    shots.push({
      name: name.replace(/\.[^.]+$/, ""),
      w: size.w,
      h: size.h,
      nodes: byImage.get(name),
      dataUri: "data:" + IMAGE_MIME[extname(name).toLowerCase()] + ";base64," + buf.toString("base64"),
    });
  }
  return shots;
}

function renderHtml(doc, registry, shots) {
  const payload = {
    ast: doc,
    registry,
    shots: shots.map((s) => ({ name: s.name, w: s.w, h: s.h, nodes: s.nodes })),
  };
  const data = JSON.stringify(payload).replace(/<\//g, "<\\/");
  const cropCss = shots.map((s, i) => ".img-" + i + "{background-image:url(" + s.dataUri + ")}").join("\n");
  const title = "UI AST Inspector — " + (doc.screen.name || "screen");
  return `<title>${title}</title>
<style>
