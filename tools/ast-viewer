function regDetail(r){
  const ri = r.registryItem || {};
  return H(r.codeComponent || "(codeComponent 未記載)") +
    (ri.type ? "\\n" + H(ri.type) : "") +
    (deps(r).length ? "\\nregistry: " + H(deps(r).join(" + ")) : "") +
    ((ri.dependencies || []).length ? "\\nnpm: " + H(ri.dependencies.join(", ")) : "") +
    ((ri.files || []).length ? "\\nfiles: " + H(ri.files.join(", ")) : "") +
    ((r.variants || []).length ? "\\nvariants: " + H(r.variants.join(" / ")) : "") +
    ((r.states || []).length ? "\\nstates: " + H(r.states.join(" / ")) : "") +
    ((r.notes || []).length ? "\\n※ " + H(r.notes.join("\\n※ ")) : "");
}
function jumpToCatalog(id){
  select(id, true);
  showPage("cat");
  const el = document.querySelector('.inst[data-id="' + id + '"]');
  if (el) el.scrollIntoView({ block: "center" });
}
function jumpToTree(id){
  showPage("tree");
  select(id, false);
}
function select(id, fromTree){
  selId = id;
  document.querySelectorAll(".node").forEach(e => e.classList.toggle("sel", e.dataset.id === id));
  document.querySelectorAll(".inst").forEach(e => e.classList.toggle("sel", e.dataset.id === id));
  document.querySelectorAll(".idchip").forEach(e => e.classList.toggle("sel", e.dataset.id === id));
  if (curShot >= 0 && !shots[curShot].nodes[id]){
    const hit = shotsWith(id)[0];
    if (hit !== undefined){ curShot = hit; renderTabs(); }
  }
  renderShot(); renderInsp();
  if (!fromTree){
    const row = document.querySelector('.node[data-id="' + id + '"]');
    if (row) row.scrollIntoView({ block: "nearest" });
  }
}
// crop はスクショごとの CSS class を background-position でずらす (data URI の展開は 1 回だけ)
function cropEl(id, si, boxW){
  const s = shots[si], r = s.nodes[id];
  const bgw = Math.min(boxW / Math.max(r[2], 0.001), 6000);
  const bgh = bgw * (s.h / s.w);
  const d = document.createElement("div");
  d.className = "crop img-" + si;
  d.style.width = boxW + "px";
  d.style.height = Math.min(r[3] * bgh, 190) + "px";
  d.style.backgroundSize = bgw + "px auto";
  d.style.backgroundPosition = "-" + (r[0] * bgw) + "px -" + (r[1] * bgh) + "px";
  return d;
}
function renderCatalog(){
  const byKind = {};
  for (const n of Object.values(nodesById)) (byKind[n.kind] = byKind[n.kind] || []).push(n);
  const kinds = Object.keys(byKind).sort((a, b) => rankOf(a) - rankOf(b) || a.localeCompare(b));
  const c = { primitive: 0, composed: 0, custom: 0, undef: 0 };
  for (const k of kinds){ const r = regOf(k); if (r) c[r.status]++; else c.undef++; }
  document.getElementById("cat-head").textContent =
    "語彙 " + kinds.length + " 種 / instance " + Object.keys(nodesById).length + " — primitive " + c.primitive +
    " · composed " + c.composed + " · custom " + c.custom + " · registry 未定義 " + c.undef +
    "。この一覧の正体は screen AST の kind census で、screen-loop ③ (部品 3 分類) の機械化入力に相当する。instance クリック = 選択同期、Ctrl+クリック = tree の該当 node へ。";
  const grid = document.getElementById("cat-grid");
  grid.innerHTML = "";
  for (const k of kinds){
    const reg = regOf(k);
    const nodes = byKind[k];
    const card = document.createElement("div");
    card.className = "kind-card";
    card.innerHTML = '<h2>' + H(k) + ' <span class="cnt">×' + nodes.length + '</span>' +
      (reg ? '<span class="st ' + H(reg.status) + '">' + H(reg.status) + '</span>' +
        (deps(reg).length ? '<span class="badge sc">' + H(deps(reg).join("·")) + '</span>' : "")
        : '<span class="st custom">registry 未定義</span>') + '</h2>' +
      '<div class="comp">' + (reg ? regDetail(reg) : "") + '</div>';
    const row = document.createElement("div");
    row.className = "inst-row";
    for (const n of nodes){
      const hits = shotsWith(n.id);
      const shown = n.responsive ? hits.slice(0, 2) : hits.slice(0, 1);
      const inst = document.createElement("div");
      inst.className = "inst" + (n.id === selId ? " sel" : "");
      inst.dataset.id = n.id;
      if (shown.length){
        const wrap = document.createElement("div");
        wrap.style.display = "flex";
        wrap.style.gap = "6px";
        for (const si of shown) wrap.appendChild(cropEl(n.id, si, shown.length > 1 ? 150 : 220));
        inst.appendChild(wrap);
      }
      const cap = document.createElement("div");
      cap.className = "cap";
      cap.textContent = "#" + n.id + (n.variant ? " · " + n.variant : "") +
        ((n.state && n.state.stateName) ? " · [" + n.state.stateName + "]" : "") +
        (n.responsive ? " · ⇄ " + Object.entries(n.responsive).map(([bp, o]) => bp + ":" + (o.kind || "layout")).join(" ") : "") +
        " · ●" + Math.round((n.confidence ?? 0) * 100) +
        (shown.length === 0 ? (shots.length ? " · (実測 region なし — 親 wrapper 内包)" : " · (スクショ未指定)") : "");
      inst.appendChild(cap);
      inst.onclick = (e) => (e.ctrlKey || e.metaKey) ? jumpToTree(n.id) : select(n.id, true);
      row.appendChild(inst);
    }
    card.appendChild(row);
    grid.appendChild(card);
  }
}
function renderRegistry(){
  const byKind = {};
  for (const n of Object.values(nodesById)) (byKind[n.kind] = byKind[n.kind] || []).push(n);
  const items = (registry.items || []).slice()
    .sort((a, b) => RANK[a.status] - RANK[b.status] || a.name.localeCompare(b.name));
  const used = items.filter(i => byKind[i.kind]).length;
  const undef = Object.keys(byKind).filter(k => !regOf(k)).sort();
  document.getElementById("reg-head").textContent =
    "共通語彙 registry v" + (registry.version || "?") + " — 定義 " + items.length + " 件 / 本画面に出現 " + used +
    " 件 / 本画面にあって registry 未定義 " + undef.length + " kind。ここが shadcn 構成 (registryDependencies) と FE component path の正本で、id chip クリックで tree の該当 node へ戻る。";
  const grid = document.getElementById("reg-grid");
  grid.innerHTML = "";
  for (const item of items){
    const nodes = byKind[item.kind] || [];
    const card = document.createElement("div");
    card.className = "kind-card";
    card.innerHTML = '<h2>' + H(item.name) + ' <span class="cnt">kind=' + H(item.kind) + ' ×' + nodes.length + '</span>' +
      '<span class="st ' + H(item.status) + '">' + H(item.status) + '</span></h2>' +
      '<div class="comp">' + regDetail(item) + '</div>';
    const row = document.createElement("div");
    row.className = "inst-row";
    for (const n of nodes) row.appendChild(idChip(n.id));
    card.appendChild(row);
    grid.appendChild(card);
  }
  if (undef.length){
    const card = document.createElement("div");
    card.className = "kind-card";
    card.innerHTML = '<h2>registry 未定義 <span class="cnt">×' + undef.length + ' kind</span>' +
      '<span class="st custom">要 registry 起票</span></h2><div class="comp">' + H(undef.join(", ")) + '</div>';
    const row = document.createElement("div");
    row.className = "inst-row";
    for (const k of undef) for (const n of byKind[k]) row.appendChild(idChip(n.id));
    card.appendChild(row);
    grid.appendChild(card);
  }
}
function idChip(id){
  const chip = document.createElement("span");
  chip.className = "idchip" + (id === selId ? " sel" : "");
  chip.dataset.id = id;
  chip.textContent = "#" + id;
  chip.onclick = (e) => (e.ctrlKey || e.metaKey) ? jumpToCatalog(id) : jumpToTree(id);
