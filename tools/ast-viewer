  --sel:rgba(179,84,42,.16);
  --sans:'Zen Kaku Gothic New','Hiragino Sans','Noto Sans JP',system-ui,sans-serif;
  --mono:'JetBrains Mono',SFMono-Regular,Menlo,Consolas,monospace;
