<script>
const DATA = ${data};
const { ast, registry, shots } = DATA;
const screen = ast.screen;
const RANK = { primitive: 0, composed: 1, custom: 2 };
let curShot = shots.length ? 0 : -1;
let selId = null;

const H = (v) => String(v).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
const uncertain = {};
for (const u of ast.uncertainNodes || []) uncertain[u.id] = u;
const nodesById = {};
const overlayIds = {};
(function index(n){ if (n.id) nodesById[n.id] = n; (n.children || []).forEach(index); })(
  { children: [...(screen.children || []), ...(screen.overlays || [])] });
(function mark(n){ if (n.id) overlayIds[n.id] = true; (n.children || []).forEach(mark); })(
  { children: screen.overlays || [] });

const regByKind = {};
for (const item of registry.items || []) (regByKind[item.kind] = regByKind[item.kind] || []).push(item);
const regOf = (kind) => (regByKind[kind] || [])[0] || null;
const rankOf = (kind) => { const r = regOf(kind); return r ? RANK[r.status] : 3; };
const shotsWith = (id) => shots.map((s, i) => i).filter((i) => shots[i].nodes[id]);
const deps = (item) => ((item.registryItem || {}).registryDependencies || []);

const prov = screen.provenance || {};
document.getElementById("ver").textContent = "ui-ast v" + (ast.version || "?");
document.getElementById("prov").textContent =
  prov.mockFile + "  sha:" + String(prov.sha256 || "").slice(0, 8) + "…  extracted:" + prov.extractedAt +
  (screen.viewport ? "  " + screen.viewport.width + "×" + screen.viewport.height + " @" + screen.viewport.breakpoint : "");
document.getElementById("cov").textContent = ast.coverage
  ? "coverage visual " + ast.coverage.visual + " / semantic " + ast.coverage.semantic : "coverage 未記載";
document.getElementById("shotwrap").hidden = shots.length === 0;
document.getElementById("legend").textContent = shots.length
  ? "枠 = node.source.region (0..1 正規化) をスクショ実寸に焼き直したもの。クリックで選択、tree と双方向同期。tree 行・枠とも Ctrl+クリックで部品一覧の該当 instance へ。"
  : "スクショ未指定 (または source.region 不在) のため region 枠面は省略。tree 行 Ctrl+クリックで部品一覧へ。";

function nodeRow(n){
  const div = document.createElement("div");
  div.className = "node"; div.dataset.id = n.id;
  const conf = Math.round((n.confidence ?? 0) * 100);
  let badges = "";
  if (overlayIds[n.id]) badges += '<span class="badge ov">overlay</span>';
  if (n.state && n.state.stateName) badges += '<span class="badge state">' + H(n.state.stateName) + '</span>';
  if (n.responsive) badges += '<span class="badge resp">⇄ responsive</span>';
  if (uncertain[n.id]) badges += '<span class="badge unc">⚑</span>';
  const reg = regOf(n.kind);
  if (reg && deps(reg).length) badges += '<span class="badge sc">' + H(deps(reg).join("·")) + '</span>';
  div.innerHTML = '<span class="k">' + H(n.kind) + '</span><span class="id">#' + H(n.id) + '</span>' + badges +
    '<span class="conf' + (conf < 90 ? ' low' : '') + '">●' + conf + '</span>';
  div.onclick = (e) => (e.ctrlKey || e.metaKey) ? jumpToCatalog(n.id) : select(n.id, true);
  return div;
}
function renderTree(){
  const root = document.getElementById("tree");
  root.innerHTML = "";
  const add = (n, parent) => {
    parent.appendChild(nodeRow(n));
    if ((n.children || []).length){
      const k = document.createElement("div"); k.className = "kids"; parent.appendChild(k);
      n.children.forEach(c => add(c, k));
    }
  };
  const s1 = document.createElement("div"); s1.className = "sect";
  s1.textContent = "SCREEN — " + screen.name + " (" + ((screen.layout || {}).type || "?") + ")";
  root.appendChild(s1);
  (screen.children || []).forEach(n => add(n, root));
  if ((screen.overlays || []).length){
    const s2 = document.createElement("div"); s2.className = "sect";
    s2.textContent = "OVERLAYS (base tree から分離)"; root.appendChild(s2);
    screen.overlays.forEach(n => add(n, root));
  }
}
function renderTabs(){
  const el = document.getElementById("tabs");
  el.innerHTML = "";
  shots.forEach((s, i) => {
    const b = document.createElement("button");
    b.className = "tab" + (i === curShot ? " on" : ""); b.textContent = s.name;
    b.onclick = () => { curShot = i; renderTabs(); renderShot(); };
    el.appendChild(b);
  });
}
function renderShot(){
  if (curShot < 0) return;
  const s = shots[curShot];
  const el = document.getElementById("shot");
  el.className = "inner img-" + curShot;
  el.style.aspectRatio = s.w + " / " + s.h;
  el.innerHTML = "";
  for (const [id, r] of Object.entries(s.nodes)){
    const b = document.createElement("div");
    b.className = "box" + (id === selId ? " sel" : "");
    b.dataset.label = ((nodesById[id] || {}).kind || "") + " #" + id;
    b.style.left = (r[0] * 100) + "%";
    b.style.top = (r[1] * 100) + "%";
    b.style.width = (r[2] * 100) + "%";
    b.style.height = (r[3] * 100) + "%";
    b.onclick = (e) => (e.ctrlKey || e.metaKey) ? jumpToCatalog(id) : select(id, false);
    el.appendChild(b);
  }
  const sel = el.querySelector(".box.sel");
  if (sel) sel.scrollIntoView({ block: "center" });
}
function renderInsp(){
  const el = document.getElementById("insp");
  const n = selId ? nodesById[selId] : null;
  if (!n){
    el.innerHTML = '<div class="hint">tree の node' + (shots.length ? "、またはスクショ上の枠" : "") +
      'をクリックすると 3 面 (mock / IR / FE) の対応を表示します。</div>';
    return;
  }
  const src = n.source || {};
  const b = n.binding || {};
  const u = uncertain[n.id];
  const hits = shotsWith(n.id).map(i => shots[i].name);
  el.innerHTML =
    '<div class="card"><h3>MOCK 側 (正本)</h3><div class="mono">' + H(prov.mockFile) +
      (src.nodeRef ? "\\nnodeRef: " + H(src.nodeRef) : "") +
      (src.file ? "\\nfile: " + H(src.file) : "") +
      (src.region ? "\\nregion: [" + src.region.map(v => v.toFixed(4)).join(", ") + "]" : "") +
      "\\n実測 region: " + H(hits.join(", ") || "(このスクショ集合には不在)") + '</div></div>' +
    '<div class="card"><h3>IR NODE</h3><div class="big">' + H(n.kind) + ' <span style="color:var(--soft)">#' + H(n.id) + '</span></div>' +
      '<div class="mono">confidence: ' + (n.confidence ?? 0) +
      (n.logicalId ? "\\nlogicalId: " + H(n.logicalId) : "") +
      (n.role ? "\\nrole: " + H(n.role) : "") +
      (n.variant ? "\\nvariant: " + H(n.variant) : "") +
      (n.state ? "\\nstate: " + H(JSON.stringify(n.state)) : "") +
      (n.responsive ? "\\nresponsive: " + H(Object.entries(n.responsive)
        .map(([bp, o]) => bp + "→" + (o.hidden ? "hidden" : (o.kind || o.variant || "layout"))).join(" / ")) : "") +
      ((n.interactions || []).length ? "\\ninteractions: " + H(n.interactions
        .map(x => x.type + "→" + x.targetId + (x.event ? " (" + x.event + ")" : "")).join(", ")) : "") +
      ((n.triggerNodeIds || []).length ? "\\ntriggers: " + H(n.triggerNodeIds.join(", ")) : "") +
      "\\nprops: " + H(n.props ? JSON.stringify(n.props, null, 1) : "(なし)") +
      ((n.evidence || []).length ? "\\n根拠: " + H(n.evidence.join(" / ")) : "") +
      ((n.alternatives || []).length ? "\\n候補: " + H(n.alternatives.join(" / ")) : "") +
      (u ? "\\n⚑ " + H(u.reason) : "") + '</div></div>' +
    '<div class="card"><h3>FE 側 (SvelteKit)</h3><div class="mono">' +
      H(b.codeComponent || "(wrapper 内部 — registry 側で解決)") +
      "\\ndata-visual-id: " + H(b.visualId || "(親 wrapper に包含)") +
      ((b.tokenRefs || []).length ? "\\ntokenRefs: " + H(b.tokenRefs.join(", ")) : "") +
