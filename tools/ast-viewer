}
function showPage(p){
  document.getElementById("page-tree").hidden = p !== "tree";
  document.getElementById("page-catalog").hidden = p !== "cat";
  document.getElementById("page-registry").hidden = p !== "reg";
  document.getElementById("pb-tree").classList.toggle("on", p === "tree");
  document.getElementById("pb-cat").classList.toggle("on", p === "cat");
  document.getElementById("pb-reg").classList.toggle("on", p === "reg");
}
document.getElementById("pb-tree").onclick = () => showPage("tree");
document.getElementById("pb-cat").onclick = () => showPage("cat");
document.getElementById("pb-reg").onclick = () => showPage("reg");

renderTree(); renderTabs(); renderShot(); renderInsp(); renderCatalog(); renderRegistry();
</script>
`;
}

function main(argv) {
  const opts = parseArgs(argv);
  const screenPath = resolve(opts.screen);
  const doc = loadJson(screenPath);
  if (!doc || typeof doc !== "object" || !doc.screen) die("not a ui-ast document: " + screenPath, 65);
  if (doc.version !== AST_VERSION) warn("ui-ast version is " + doc.version + " (expected " + AST_VERSION + ")");
  const astDir = dirname(screenPath);

  const registryPath = opts.registry ? resolve(opts.registry) : join(astDir, "..", "registry.json");
  let registry = { version: AST_VERSION, items: [] };
  if (opts.registry || existsSync(registryPath)) registry = loadJson(registryPath);
  else warn("registry not found: " + registryPath + " (registry 面は空で描画)");
  if (!Array.isArray(registry.items)) die("registry has no items[]: " + registryPath, 65);

  let shotsDir = opts.screenshots ? resolve(opts.screenshots) : join(astDir, "..", "..", "ui-mock", "screenshots");
  if (!opts.screenshots && !existsSync(shotsDir)) shotsDir = "";
  const shots = buildShots(indexNodes(doc.screen), shotsDir);
  if (shotsDir && !shots.length) warn("no node carries a resolvable source.region (region 枠面を省略)");

  const slug = doc.screen.name || basename(screenPath).replace(/\.ui-ast\.json$/, "");
  const outPath = opts.out ? resolve(opts.out) : resolve(process.cwd(), slug + ".viewer.html");
  const html = renderHtml(doc, registry, shots);
  writeFileSync(outPath, html);
  const bytes = Buffer.byteLength(html);
  process.stdout.write(outPath + "  " + bytes + " bytes (" + (bytes / 1024).toFixed(1) + " KB, shots " + shots.length + ")\n");
  return 0;
}

process.exit(main(process.argv.slice(2)));
